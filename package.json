{
  "name": "cognautic-forge",
  "version": "0.0.2",
  "private": false,
  "type": "commonjs",
  "description": "Cognautic Forge - local-first AI co-worker CLI",
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "bin": {
